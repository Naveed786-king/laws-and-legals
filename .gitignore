# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.iml
*.ipr
*.iws
.idea/

# Platform folders are generated fresh by CI via `flutter create --platforms=android .`
# so the Gradle/AGP/Kotlin versions always match the Flutter SDK version used to build.
/android/
/ios/

# Firebase Android config lives in /firebase-config/google-services.json and
# IS committed (private repo; this value isn't a secret by Firebase's design -
# it's protected by Firestore/Storage security rules, not by hiding this file).
# The web admin panel's config is similarly non-secret and lives in
# admin-panel/js/firebase-config.js, also committed.

.DS_Store
*.log
